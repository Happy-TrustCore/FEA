{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "module": "none",
    "outFile": "assets/js/fea.js",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "files": [
    "src/ts/types.ts",
    "src/ts/lang.ts",
    "src/ts/directory.ts",
    "src/ts/analyzer.ts",
    "src/ts/chat.ts",
    "src/ts/main.ts"
  ]
}
